{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "csv/tax_rates.schema.json",
  "title": "tax_rates.csv",
  "description": "Tax rates for the tax estimate page, one row per government, tax and year, each with its source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "government",
    "tax",
    "year",
    "label",
    "rate",
    "unit",
    "assessed_year",
    "account",
    "source",
    "evidence"
  ],
  "properties": {
    "government": {
      "type": "string",
      "x-type": "choice",
      "description": "Which government levies the tax.",
      "enum": [
        "city",
        "county"
      ],
      "examples": [
        "city"
      ]
    },
    "tax": {
      "type": "string",
      "x-type": "choice",
      "description": "real_estate (rate in mills on assessed value) or earned_income (rate in % of earned income).",
      "enum": [
        "real_estate",
        "earned_income"
      ],
      "examples": [
        "real_estate"
      ]
    },
    "year": {
      "type": "string",
      "x-type": "year",
      "description": "The tax year.",
      "pattern": "^(19|20|21)\\d\\d$",
      "minLength": 1,
      "examples": [
        "2026"
      ]
    },
    "label": {
      "type": "string",
      "x-type": "text",
      "description": "The rate's label on the site.",
      "minLength": 1,
      "examples": [
        "2026"
      ]
    },
    "rate": {
      "type": "string",
      "x-type": "number",
      "description": "The rate as published.",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "minLength": 1,
      "examples": [
        "12.64"
      ]
    },
    "unit": {
      "type": "string",
      "x-type": "choice",
      "description": "mills for real_estate, % for earned_income.",
      "enum": [
        "mills",
        "%"
      ],
      "examples": [
        "mills"
      ]
    },
    "assessed_year": {
      "type": "string",
      "x-type": "year",
      "description": "real_estate only: which year's assessed values the rate applies to.",
      "pattern": "^$|^(19|20|21)\\d\\d$",
      "examples": [
        "2026"
      ]
    },
    "account": {
      "type": "string",
      "x-type": "account code",
      "description": "The budget line the tax is booked to (org-object), if any.",
      "pattern": "^$|^\\d+-(\\d+|TBD)$",
      "examples": [
        "1000001-400000"
      ]
    },
    "source": {
      "type": "string",
      "x-type": "text",
      "description": "Where the rate is published (a web address, a PDF link, or a plain note).",
      "minLength": 1,
      "examples": [
        "https://co.lancaster.pa.us/DocumentCenter/View/19105/2026-County-Municipal-and-2025-202..."
      ]
    },
    "evidence": {
      "type": "string",
      "x-type": "text",
      "description": "The exact wording or table row that gives the rate.",
      "minLength": 1,
      "examples": [
        "County millage table, 2026: \"331-339 Lancaster City 3.201 12.640000 25.4776 41.3186\""
      ]
    }
  }
}
