{
  "_comment": "Layout of one scanned budget book, read by scripts/extract_scanned.py. Copy this file for another year and change what differs.",
  "source_doc": "2024-Adopted-Budget.pdf",
  "document_note": "Text-layer book. Budget column is headed '2024 PROPOSED'; kept as doc_type 'proposed'.",
  "line_items": {
    "_comment": "Pages whose header matches every column below, left to right. 'header' is a regex matched against the column's stacked header words joined with spaces.",
    "total_prefix": "^TOTAL\\b\\s*[-_]?\\s*",
    "inherit_header": true,
    "layouts": [
      {
        "name": "main",
        "columns": [
          {
            "header": "^2022 ACTUAL$",
            "fiscal_year": 2022,
            "doc_type": "actual"
          },
          {
            "header": "^2023 ORIGINAL BUDGET$",
            "fiscal_year": 2023,
            "doc_type": "adopted"
          },
          {
            "header": "^2023 AMENDED BUDGET$",
            "fiscal_year": 2023,
            "doc_type": "amended"
          },
          {
            "header": "^(?:RECEIVED|EXPENDED) YTD (\\d{1,2}/\\d{1,2}/\\d{4})$",
            "fiscal_year": 2023,
            "doc_type": "actual_ytd"
          },
          {
            "header": "^2023 PROJECTED$",
            "fiscal_year": 2023,
            "doc_type": "projected"
          },
          {
            "header": "^2024 PROPOSED$",
            "fiscal_year": 2024,
            "doc_type": "proposed"
          }
        ],
        "header_last_line": "ACTUAL.*PROPOSED"
      },
      {
        "name": "five_columns",
        "_comment": "pp61-62, 66-67 print only the five 2022/2023 columns (Neighborhood Engagement, Tourism under their old 1103000/1104000 org codes).",
        "columns": [
          {
            "header": "^2022 ACTUAL$",
            "fiscal_year": 2022,
            "doc_type": "actual"
          },
          {
            "header": "^2023 ORIGINAL BUDGET$",
            "fiscal_year": 2023,
            "doc_type": "adopted"
          },
          {
            "header": "^2023 AMENDED BUDGET$",
            "fiscal_year": 2023,
            "doc_type": "amended"
          },
          {
            "header": "^(?:RECEIVED|EXPENDED) YTD (\\d{1,2}/\\d{1,2}/\\d{4})$",
            "fiscal_year": 2023,
            "doc_type": "actual_ytd"
          },
          {
            "header": "^2023 PROJECTED$",
            "fiscal_year": 2023,
            "doc_type": "projected"
          }
        ],
        "header_last_line": "ACTUAL.*PROJECTED$"
      },
      {
        "name": "proposed_only",
        "_comment": "pp63-64, 68-69, 71-72 print only the 2024 column, under the new 1300000-series org codes.",
        "columns": [
          {
            "header": "^2024$",
            "fiscal_year": 2024,
            "doc_type": "proposed"
          }
        ],
        "header_last_line": "^2024$"
      }
    ]
  },
  "staffing": {
    "_comment": "pp65, 70, 73 print whole-number counts and no object code; Treasury (p82) prints 3-decimal FTEs.",
    "columns": [
      {
        "fiscal_year": 2024,
        "doc_type": "proposed"
      }
    ],
    "row": [
      "count",
      "title",
      "salary"
    ],
    "count_pattern": "^\\d+(\\.\\d{1,3})?$"
  },
  "funds": {
    "_comment": "Org-code prefix (first 3 digits of 8-digit codes) -> fund. 7-digit codes are General Fund.",
    "560": "Stormwater Management Fund",
    "561": "Sewer Fund",
    "562": "Water Fund",
    "563": "Solid Waste & Recycling Fund",
    "662": {
      "fund": "Long's Park Fund",
      "department": "Public Works"
    },
    "265": {
      "fund": "Liquid Fuels Fund",
      "department": "Public Works"
    }
  },
  "general_fund_departments": {
    "10": "General Revenue",
    "11": "Executive",
    "12": "Legislative",
    "13": "Neighborhood Engagement",
    "14": "Administrative Services",
    "15": "Public Safety",
    "16": "Community Planning & Economic Development",
    "18": "Public Works"
  },
  "general_fund_department_overrides": {
    "_comment": "Check against this book's General Fund Expense Summary.",
    "1403": "City Controller / Treasurer"
  },
  "source": "text"
}