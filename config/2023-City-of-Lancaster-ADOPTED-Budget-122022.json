{
  "_comment": "Layout of one scanned budget book, read by scripts/extract_scanned.py. Copy this file for another year and change what differs.",
  "source_doc": "2023-City-of-Lancaster-ADOPTED-Budget-122022.pdf",
  "document_note": "Text-layer book. Budget column is headed '2023 PROPOSED'; kept as doc_type 'proposed'.",
  "line_items": {
    "_comment": "Pages whose header matches every column below, left to right. 'header' is a regex matched against the column's stacked header words joined with spaces.",
    "columns": [
      {
        "header": "^2021 ACTUAL$",
        "fiscal_year": 2021,
        "doc_type": "actual"
      },
      {
        "header": "^2022 ORIGINAL BUDGET$",
        "fiscal_year": 2022,
        "doc_type": "adopted"
      },
      {
        "header": "^2022 AMENDED BUDGET$",
        "fiscal_year": 2022,
        "doc_type": "amended"
      },
      {
        "header": "^(?:RECEIVED|EXPENDED) YTD (\\d{1,2}/\\d{1,2}/\\d{4})$",
        "fiscal_year": 2022,
        "doc_type": "actual_ytd"
      },
      {
        "header": "^2022 PROJECTED$",
        "fiscal_year": 2022,
        "doc_type": "projected"
      },
      {
        "header": "^2023 PROPOSED$",
        "fiscal_year": 2023,
        "doc_type": "proposed"
      }
    ],
    "header_last_line": "ACTUAL.*PROPOSED",
    "total_prefix": "^TOTAL\\b\\s*[-_]?\\s*",
    "inherit_header": false
  },
  "staffing": {
    "_comment": "Staffing schedule rows: org, object, title, bargaining unit, FT/PT, then one (count, salary) pair per column.",
    "columns": [
      {
        "fiscal_year": 2023,
        "doc_type": "proposed"
      }
    ],
    "row": [
      "count",
      "title",
      "salary"
    ]
  },
  "funds": {
